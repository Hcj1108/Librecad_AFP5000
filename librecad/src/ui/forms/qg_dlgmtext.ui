     <property name="styleSheet">
      <string notr="true">QPushButton{font: bold 12px &quot;Microsoft YaHei&quot;; padding: 1px 20px; border-radius: 6px; min-width: 50px;}
QPushButton[text=&quot;OK&quot;], QPushButton[text=&quot;确定&quot;]{background: #3498db; color: white;}
QPushButton[text=&quot;OK&quot;]:hover, QPushButton[text=&quot;确定&quot;]:hover{background: #2980b9;}
QPushButton[text=&quot;Cancel&quot;], QPushButton[text=&quot;取消&quot;]{background: #95a5a6; color: white;}
QPushButton[text=&quot;Cancel&quot;]:hover, QPushButton[text=&quot;取消&quot;]:hover{background: #7f8c8d;}</string>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::StandardButton::Cancel|QDialogButtonBox::StandardButton::Ok</set>
